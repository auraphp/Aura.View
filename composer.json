{
    "name": "aura/view",
    "type": "library",
    "description": "Provides an implementation of the TemplateView and TwoStepView patterns, with support for helpers and for closures as templates, using PHP itself as the templating language.",
    "keywords": [
        "escape",
        "escaper",
        "escaping",
        "template",
        "template view",
        "two step view",
        "two-step view",
        "twostep view",
        "view"
    ],
    "homepage": "https://github.com/auraphp/Aura.View",
    "license": "BSD-2-Clause",
    "authors": [
        {
            "name": "Aura.View Contributors",
            "homepage": "https://github.com/auraphp/Aura.View/contributors"
        }
    ],
    "require": {
        "php": "^8.4"
    },
    "require-dev": {
        "phpunit/phpunit": "^12.0",
        "phpstan/phpstan": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "Aura\\View\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Aura\\View\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "test-coverage": "php -d xdebug.mode=coverage phpunit --coverage-clover=coverage.xml",
        "phpstan": "phpstan analyse --level=2 src/"
    }
}
